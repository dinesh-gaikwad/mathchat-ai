# Copy this file to .env and fill in real values before running the server

# MongoDB connection string (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/iti_apprenticeship_portal

# Port the Express server listens on
PORT=5000

# Secret used to sign JWT tokens - use a long random string in production
JWT_SECRET=replace_this_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d

# Comma separated list of frontend origins allowed to call this API
CLIENT_ORIGIN=http://localhost:3000
